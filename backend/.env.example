# Copy this file to backend/.env and adjust values.
# Real environment variables always take precedence over this file.

# HTTP port for the Go API
PORT=8080

# MongoDB (docker compose up -d starts one on localhost:27017)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=soc_platform

# SOP parser engine:
#   fallback      - rule-based indentation parser only (no LLM needed)
#   ollama        - local Ollama server (LLM_ENDPOINT=http://localhost:11434)
#   colab_ollama  - Ollama exposed from Colab via a tunnel URL
#   hf_api        - Hugging Face Inference router (needs HF_TOKEN)
# If the LLM call fails, the engine automatically falls back to the rule-based parser.
LLM_PROVIDER=fallback
LLM_ENDPOINT=http://localhost:11434
LLM_MODEL=qwen2.5:3b

# Only required for LLM_PROVIDER=hf_api
HF_TOKEN=
